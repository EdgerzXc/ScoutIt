# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test and audit output
/coverage/
/test-results/
/playwright-report/
/.lighthouseci/
/audit_report.json
/lighthouse-report.json
/error-overlay-*.png

# Next.js and production output
/.next/
/out/
/build/

# Local and generated files
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.aider*

# Environment and deployment state
.env*
# ...but the template MUST be tracked -- being committed is its entire purpose.
# Without this negation a fresh clone gets zero environment documentation, which
# is how 31 required variables went undocumented (A-015). Real .env files above
# stay ignored; verify with: git check-ignore -v .env.local
!.env.example
.vercel/

# Reference assets and local tool state
/reference/
/.claude/
/.ua/
/.agents/
/awesome-legal-skills-temp/
/awesome-llm-apps/



# Archived/superseded local review material
/_REVIEW_QUEUE/

# One-off generated repair/debug scripts
/fix_*.js
/inject*.js
/add_*.js
/execute.js
/extract_*.js
/final_*.js
/perfect_fix.js
/recover_*.js
/strip_and_link.js
/debug-*.html
/scratch_debug*.js

# Scratch workspace and captures
/shots/
/find-clicks*.js
/scratch/
/scratch_*.png
/scratch_*.js
# Agent review captures left at the repo root (e.g. .codex-profile-review.png).
# The file stays on disk for whoever wants it; it just is not repo content.
/.codex-*.png

# ScoutIt Second Brain — local strategy/scenario knowledge base. It will move
# to its own private location; only already-tracked handoff files remain in git.
# The tracked Section 15 shelf preserves those former root records in one place.
/_SCOUTIT_BRAIN/*
!/_SCOUTIT_BRAIN/15_IMPLEMENTATION_RECORDS/
!/_SCOUTIT_BRAIN/15_IMPLEMENTATION_RECORDS/**

# The execution-control system is deliberately tracked. Keep the rest of the
# private Brain ignored; these narrow exceptions prevent the live queue and its
# preserved migration inbox from disappearing between machines.
!/_SCOUTIT_BRAIN/08_OPERATIONS_AND_BACKLOG/
