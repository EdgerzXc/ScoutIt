{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScoutItMasterFlowGraphSchemaV2",
  "description": "Authoritative JSON Schema for ScoutIt Master Flow Graph Schema V2.2 nodes, first-class semantic edges, evidence grounding, telemetry, predicates, release statuses, and governance.",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["2.0.0", "2.1.0", "2.2.0"]
    },
    "schemaVersion": { "type": "string" },
    "graphVersion": { "type": "string" },
    "bundleVersion": { "type": "string" },
    "dataRevision": { "type": "string" },
    "generatedAt": { "type": "string" },
    "lastVerifiedAt": { "type": "string" },
    "repo": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "commitSha": { "type": "string" }
      }
    },
    "brain": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "commitSha": { "type": "string" }
      }
    },
    "generator": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "commitSha": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "totalNodes": { "type": "integer" },
        "totalEdges": { "type": "integer" },
        "verifiedNodes": { "type": "integer" },
        "partialNodes": { "type": "integer" },
        "plannedNodes": { "type": "integer" },
        "proposedNodes": { "type": "integer" }
      }
    },
    "productStats": {
      "type": "object",
      "properties": {
        "approved": { "type": "integer" },
        "planned": { "type": "integer" },
        "proposed": { "type": "integer" },
        "deprecated": { "type": "integer" }
      }
    },
    "implementationStats": {
      "type": "object",
      "properties": {
        "notStarted": { "type": "integer" },
        "partial": { "type": "integer" },
        "implemented": { "type": "integer" },
        "verified": { "type": "integer" },
        "contradicted": { "type": "integer" }
      }
    },
    "evidenceStats": {
      "type": "object",
      "properties": {
        "unverified": { "type": "integer" },
        "documented": { "type": "integer" },
        "codeGrounded": { "type": "integer" },
        "testGrounded": { "type": "integer" },
        "runtimeGrounded": { "type": "integer" }
      }
    },
    "releaseStats": {
      "type": "object",
      "properties": {
        "notDeployed": { "type": "integer" },
        "deployedDisabled": { "type": "integer" },
        "privatePilot": { "type": "integer" },
        "limitedLive": { "type": "integer" },
        "publicLive": { "type": "integer" },
        "rolledBack": { "type": "integer" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Edge"
      }
    }
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": [
        "id",
        "canonicalId",
        "name",
        "nodeType",
        "domain",
        "productStatus",
        "implementationStatus",
        "evidenceStatus",
        "releaseStatus",
        "actorRoles",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string" },
        "canonicalId": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
        },
        "name": { "type": "string" },
        "nodeType": {
          "type": "string",
          "enum": [
            "ENTRY", "LAYER", "PAGE", "SECTION", "ACTION", "DECISION",
            "GATE", "SYSTEM", "EXCEPTION", "RECOVERY", "OUTCOME", "TERMINAL", "STATE"
          ]
        },
        "type": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["architecture", "scenario"]
        },
        "domain": {
          "type": "string",
          "enum": [
            "core", "property", "deal", "auth", "connects", "owner",
            "broker", "sentinel", "gis", "admin", "legal", "infrastructure",
            "layer", "discovery", "seeker", "faq", "crm", "freshness", "operator",
            "provider", "enterprise", "moderation", "support", "security", "analytics"
          ]
        },
        "layer": { "type": "string" },
        "route": { "type": "string" },
        "actorRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["visitor", "seeker", "owner", "broker", "provider", "operator", "staff", "admin", "enterprise"]
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["visitor", "seeker", "owner", "broker", "provider", "operator", "staff", "admin", "enterprise"]
          }
        },
        "uiAudience": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["PUBLIC", "AUTHENTICATED", "SEEKER", "OWNER", "BROKER", "PROVIDER", "OPERATOR", "STAFF", "ADMIN", "ENTERPRISE"]
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["PUBLIC", "AUTHENTICATED", "SEEKER", "OWNER", "BROKER", "PROVIDER", "OPERATOR", "STAFF", "ADMIN", "ENTERPRISE"]
          }
        },
        "knowledgeScope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["PUBLIC", "AUTHENTICATED", "ROLE_RESTRICTED", "INTERNAL", "STAFF", "ADMIN"]
          }
        },
        "securityClassification": {
          "type": "string",
          "enum": ["PUBLIC", "AUTHENTICATED", "ROLE_RESTRICTED", "INTERNAL", "CONFIDENTIAL", "SECURITY_SENSITIVE"]
        },
        "guideability": {
          "type": "string",
          "enum": ["NONE", "MACRO", "EXECUTABLE"]
        },
        "productStatus": {
          "type": "string",
          "enum": ["PROPOSED", "PLANNED", "APPROVED", "DEPRECATED"]
        },
        "implementationStatus": {
          "type": "string",
          "enum": [
            "NOT_STARTED", "PARTIAL", "IMPLEMENTED", "VERIFIED",
            "UNVERIFIED", "CONTRADICTED", "DEPRECATED"
          ]
        },
        "evidenceStatus": {
          "type": "string",
          "enum": ["UNVERIFIED", "DOCUMENTED", "CODE_GROUNDED", "TEST_GROUNDED", "RUNTIME_GROUNDED"]
        },
        "releaseStatus": {
          "type": "string",
          "enum": ["NOT_DEPLOYED", "DEPLOYED_DISABLED", "PRIVATE_PILOT", "LIMITED_LIVE", "PUBLIC_LIVE", "ROLLED_BACK"]
        },
        "viewState": { "type": "string" },
        "routeType": {
          "type": "string",
          "enum": [
            "EXACT_MATCH", "DYNAMIC_EQUIVALENT", "QUERY_STATE_VARIANT",
            "HASH_SECTION_VARIANT", "REDIRECT_ALIAS", "CLIENT_STATE",
            "POSSIBLE_ALIAS", "REAL_UNMAPPED_ROUTE", "GRAPH_ONLY_ROUTE", "CONTRADICTED_ROUTE"
          ]
        },
        "redirectTo": { "type": "string" },
        "purpose": { "type": "string" },
        "description": { "type": "string" },
        "actions": { "type": "array", "items": { "type": "string" } },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "exceptions": { "type": "array", "items": { "type": "string" } },
        "recovery": { "type": "array", "items": { "type": "string" } },
        "database": { "type": "string" },
        "auth": { "type": "string" },
        "systems": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } },
        "apis": { "type": "array", "items": { "type": "string" } },
        "dataRefs": { "type": "array", "items": { "type": "string" } },
        "brainRefs": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Claim"
          }
        },
        "legalReviewStatus": {
          "type": "string",
          "enum": ["UNREVIEWED", "RESEARCHED", "PRODUCT_APPROVED", "LEGAL_APPROVED", "DISPUTED", "APPROVED"]
        },
        "machineVerifiedBy": { "type": ["string", "null"] },
        "machineVerificationStatus": { "type": "string" },
        "humanReviewedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] },
        "productReviewStatus": { "type": "string" },
        "securityReviewStatus": { "type": "string" },
        "pilotState": { "type": "string" },
        "currentState": { "type": "string" },
        "resumeIntent": { "type": "string" },
        "returnTarget": { "type": "string" },
        "originNode": { "type": "string" },
        "continuationTarget": { "type": "string" },
        "isTerminal": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
        "resourceRelationship": { "type": "array", "items": { "type": "string" } },
        "ownershipRequirement": { "type": "boolean" },
        "dealParticipationRequired": { "type": "boolean" },
        "representationRequired": { "type": "boolean" },
        "governance": {
          "type": "object",
          "properties": {
            "domainOwner": { "type": ["string", "null"] },
            "reviewer": { "type": ["string", "null"] },
            "riskLevel": { "type": "string", "enum": ["STANDARD", "HIGH", "CRITICAL"] },
            "approvedAt": { "type": ["string", "null"] },
            "validFrom": { "type": ["string", "null"] },
            "reviewAfter": { "type": ["string", "null"] },
            "deprecatedBy": { "type": ["string", "null"] },
            "changeReason": { "type": ["string", "null"] }
          }
        },
        "guide": {
          "type": "object",
          "properties": {
            "instruction": { "type": "string" },
            "target": { "type": "string" },
            "sequenceOrder": { "type": "integer" }
          }
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "eventName": { "type": "string" },
            "payloadProperties": { "type": "array", "items": { "type": "string" } }
          }
        },
        "version": { "type": "string" },
        "lastVerifiedAt": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "parents": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Edge": {
      "type": "object",
      "required": ["id", "source", "target", "type"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "NAVIGATE", "ACTION", "SUBMIT", "SUCCESS", "FAILURE",
            "RETRY", "RECOVERY", "AUTH_GATE", "PERMISSION_GATE",
            "CONDITION_TRUE", "CONDITION_FALSE", "TERMINATE", "SYSTEM"
          ]
        },
        "branchKey": { "type": "string" },
        "label": { "type": "string" },
        "trigger": { "type": "string" },
        "predicate": {
          "type": ["object", "null"],
          "properties": {
            "field": { "type": "string" },
            "operator": { "type": "string", "enum": ["==", "!=", ">", "<", ">=", "<=", "in", "contains"] },
            "value": {},
            "quality": { "type": ["string", "null"], "enum": ["DOMAIN_DECISION", "GENERIC_NAVIGATION", null] }
          },
          "required": ["field", "operator"]
        },
        "quality": { "type": ["string", "null"], "enum": ["DOMAIN_DECISION", "GENERIC_NAVIGATION", null] },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "postconditions": { "type": "array", "items": { "type": "string" } },
        "failureReason": { "type": "string" },
        "errorClass": { "type": "string" },
        "resumeIntent": { "type": "string" },
        "returnTarget": { "type": "string" },
        "originNode": { "type": "string" },
        "continuationTarget": { "type": "string" },
        "stateMachineId": { "type": "string" },
        "stateTransition": {
          "type": "object",
          "properties": {
            "fromState": { "type": "string" },
            "toState": { "type": "string" }
          }
        },
        "temporal": {
          "type": "object",
          "properties": {
            "timeout": { "type": "string" },
            "expiresAfter": { "type": "string" },
            "retryPolicy": {
              "type": "object",
              "properties": {
                "maxRetries": { "type": "integer" },
                "backoff": { "type": "string" }
              }
            },
            "idempotencyKey": { "type": "string" },
            "conflictPolicy": { "type": "string" },
            "compensatingAction": { "type": "string" }
          }
        },
        "roles": { "type": "array", "items": { "type": "string" } },
        "visibility": { "type": "array", "items": { "type": "string" } },
        "effects": { "type": "array", "items": { "type": "string" } },
        "apiRefs": { "type": "array", "items": { "type": "string" } },
        "mutationApi": { "type": "string" },
        "idempotent": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "recoveryTarget": { "type": ["string", "null"] },
        "guideInstruction": { "type": "string" },
        "guideTarget": { "type": "string" },
        "telemetryEvent": { "type": "string" },
        "implementationStatus": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "required": ["kind", "provenance"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CODE", "ROUTE", "COMPONENT", "API", "DATABASE",
            "TEST", "SCOUTIT_BRAIN", "APPROVED_PRODUCT_DECISION",
            "AUTHORITATIVE_EXTERNAL_REQUIREMENT"
          ]
        },
        "path": { "type": "string" },
        "symbol": { "type": "string" },
        "commitSha": { "type": "string" },
        "lineRange": { "type": "string" },
        "contentHash": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "type": "string" }
      }
    },
    "Claim": {
      "type": "object",
      "required": ["id", "text", "status"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "PRODUCT_BEHAVIOR", "LAW", "REGULATORY_GUIDANCE",
            "SCOUTIT_POLICY", "PRODUCT_INTERPRETATION", "LEGAL_REVIEWED_INTERPRETATION"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["VERIFIED", "PARTIAL", "PLANNED", "PROPOSED", "UNVERIFIED", "CONTRADICTED", "DEPRECATED"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        },
        "confidence": { "type": "number" },
        "reviewedBy": { "type": ["string", "null"] },
        "machineVerifiedBy": { "type": ["string", "null"] },
        "humanReviewedBy": { "type": ["string", "null"] },
        "reviewStatus": { "type": "string" },
        "reviewedAt": { "type": ["string", "null"] }
      }
    }
  }
}
