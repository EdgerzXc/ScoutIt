# Mission Control authenticates staff by Supabase magic link by default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keep Google hidden until the Supabase Google provider, OAuth credentials,
# callback URL, and redirect allowlist are all verified for this deployment.
NEXT_PUBLIC_SUPABASE_GOOGLE_AUTH_ENABLED=false
