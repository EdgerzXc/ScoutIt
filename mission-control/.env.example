# ===========================================================================
# ScoutIt Mission Control Environment Contract
# ===========================================================================
# Copy to .env.local and fill in real values. NOTHING in this file is a real
# credential -- every value is a placeholder.
# ===========================================================================

# --- Supabase (Core Auth & Database) ---------------------------------------
# [required] Supabase project URL (must match the main app's Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [required] Supabase anonymous key (public browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [required] Supabase service role key (bypasses RLS for staff management & actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# [optional] Staff OAuth Google authentication toggle (default: false)
NEXT_PUBLIC_SUPABASE_GOOGLE_AUTH_ENABLED=false

# [optional] Cloudflare Turnstile CAPTCHA site key for login protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key


# --- Staff App Routing -----------------------------------------------------
# [required] Mission Control application public URL (e.g. https://admin.scoutit.space)
NEXT_PUBLIC_APP_URL=https://admin.scoutit.space


# --- Public CMS (Airtable) -------------------------------------------------
# [required] Airtable Personal Access Token (PAT) with read/write access to CMS
AIRTABLE_API_KEY=your-airtable-pat

# [required] Airtable Base ID containing Properties and Articles tables
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX


# --- Cron & Automated Scans ------------------------------------------------
# [required] Secret used to authorize cron routes (/api/scan/process)
CRON_SECRET=your-secure-cron-secret-key


# --- Security & Anti-Malware -----------------------------------------------
# [optional] VirusTotal API key for binary payload analysis in fileScan.js
VIRUSTOTAL_API_KEY=your-virustotal-api-key


# --- AI Engine -------------------------------------------------------------
# [optional] Google Gemini API key for Mission Control Brain operations
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001


# --- Cache & Performance ---------------------------------------------------
# [optional] Upstash Redis for catalogue caching and health telemetry
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token


# --- Staff Email & Notifications -------------------------------------------
# [optional] Resend API key for staff notifications and invites
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=ScoutIt Operations <operations@scoutit.space>
