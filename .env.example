# ===========================================================================
# ScoutIt environment contract
# ===========================================================================
# Copy to .env.local and fill in real values. NOTHING in this file is a real
# credential -- every value is a placeholder.
#
# WHY THIS FILE IS EXHAUSTIVE (A-015):
# Most of this codebase degrades SILENTLY when a variable is missing. The
# reactions route returned { ok: true } while writing nothing because its table
# id was never set; a broken AIRTABLE_API_KEY once served mock data on both
# Vercel projects and nobody noticed for days. An undocumented variable is a
# future outage that will not announce itself.
#
# src/lib/__tests__/envContract.test.js derives the required list from the
# source and fails if this file drifts from it. Add the variable here in the
# same change that adds the process.env read.
#
# Legend:  [required] absent = feature is broken or unsafe
#          [optional] absent = feature degrades in a defined, intended way
# ===========================================================================


# --- Supabase --------------------------------------------------------------

# [required] Project URL. Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [required] Anon key. Public by design -- it is only safe because RLS is what
# actually restricts access. Never treat this as a secret or as a substitute
# for row-level policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [required] Service role key. BYPASSES ROW LEVEL SECURITY COMPLETELY.
# Server-only. Never prefix with NEXT_PUBLIC_, never import into a client
# component, never log it. Absent: every admin/cron/server write path fails.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# [required] Google Sign-In client id. Public: used by the browser SDK.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# --- Airtable (public CMS content) -----------------------------------------

# [required] Personal access token. Server-only -- DO NOT add NEXT_PUBLIC_.
# Absent or invalid: the site silently serves mock fallback data. This has
# happened in production before; it is the reason /api/health probes Airtable.
AIRTABLE_API_KEY=your-airtable-pat

# [required] Base id holding PROPERTIES_CMS and INTEL_CMS.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# [optional] Table id for anonymous property reactions. Absent: /api/reactions
# answers 503 and records nothing. Before U-010 it answered { ok: true } and
# still recorded nothing, which is how this went unnoticed -- see owner action
# O-010 before assuming reactions have ever been captured.
AIRTABLE_REACTIONS_TABLE_ID=tblXXXXXXXXXXXXXX


# --- Mapbox ----------------------------------------------------------------

# [required] Browser token. Public, and MUST be URL-restricted in the Mapbox
# dashboard, because it is visible to anyone who views source.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-token

# [required] Server token for geocoding, isochrones and routing. Must NOT be
# URL-restricted -- server requests send no Referer, so a restricted token
# fails silently. Absent: server-side Mapbox features stop working.
MAPBOX_SERVER_TOKEN=pk.your-server-token

# [optional] Legacy fallback name for the server token, still read if
# MAPBOX_SERVER_TOKEN is unset. Prefer the name above for new setups.
MAPBOX_ACCESS_TOKEN=


# --- Email delivery (Resend) -----------------------------------------------

# [required] Resend API key. Absent: /api/health reports email as
# "unconfigured" and no transactional mail is sent.
RESEND_API_KEY=re_your_api_key

# [required] From address. Must be on a domain verified in Resend. Using
# Resend's shared test sender is why signup mail landed in spam.
EMAIL_FROM=ScoutIt <hello@your-verified-domain.com>

# [required] Where public contact-form submissions are delivered.
CONTACT_NOTIFY_TO=you@your-domain.com


# --- Abuse protection ------------------------------------------------------

# [required] Cloudflare Turnstile site key. Public: rendered in the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# [required] Turnstile secret, server-only. Absent: the guard cannot verify
# tokens. Do NOT ship Cloudflare's test secret to production -- the code logs a
# warning if you do.
TURNSTILE_SECRET=your-turnstile-secret

# [optional] Legacy name for the same secret, read only as a fallback.
TURNSTILE_SECRET_KEY=

# [required] Salt for hashing client IPs before they are stored, so telemetry
# and contact records hold no raw addresses. Absent: those paths fail closed
# rather than storing unsalted IPs. Use a long random value; changing it makes
# previously-hashed IPs uncorrelatable, which is intentional.
IP_SALT=generate-a-long-random-string

# [required] Secret used to sign shareable wishlist links. Absent: share-link
# creation and verification fail. Rotating it invalidates every live link.
WISHLIST_SHARE_SECRET=generate-a-long-random-string

# [required] Shared secret authorising the Vercel cron endpoints. Absent or
# mismatched: /api/cron/* refuse the request. Without it those routes would be
# publicly triggerable, including the chat-message purge.
CRON_SECRET=generate-a-long-random-string


# --- Rate limiting / cache store (Upstash Redis) ---------------------------

# [optional] Upstash REST endpoint and token, used by the CMS cache. Absent:
# the cache falls back to in-process memory, which is per-instance. The rate
# limiter is per-instance regardless -- see src/lib/rateLimit.js.
UPSTASH_REDIS_REST_URL=
# [optional] Paired with the URL above; both must be set or neither is used.
UPSTASH_REDIS_REST_TOKEN=


# --- AI providers ----------------------------------------------------------

# [optional] Gemini key for AI Promote, listing assimilation and rewrites.
# Absent: those routes serve their deterministic fact-sheet output instead,
# which is a supported path rather than an error.
GEMINI_API_KEY=

# [optional] Gemini model id. Always read from here -- never hardcode a model
# name, because model ids are retired on Google's schedule and a hardcoded one
# turns into a silent 404 later.
GEMINI_MODEL=gemini-2.5-flash

# [optional] Anthropic key for the admin SEO generator. Absent: that admin tool
# reports it is unconfigured.
ANTHROPIC_API_KEY=


# --- Monitoring and analytics ----------------------------------------------

# [optional] Sentry DSN. Public by design. Absent: reportError() returns false
# and nothing is captured -- the Sentry wiring is complete in code, so this one
# value is the difference between having error monitoring and not having it.
NEXT_PUBLIC_SENTRY_DSN=

# [optional] GA4 measurement id. Absent: the analytics script is not injected.
NEXT_PUBLIC_GA_ID=

# [optional] Google Search Console verification token, rendered as a meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# --- Site identity ---------------------------------------------------------

# [optional] Canonical site URL. Set it so OAuth redirect URIs and generated
# share/OG links are stable. Local dev defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# [optional] Origin the CMS cache treats as the live content source. Defaults
# to the production site when unset.
SCOUTIT_LIVE_CMS_URL=


# --- Calendar sync ---------------------------------------------------------

# [optional] Google Calendar OAuth credentials (console.cloud.google.com).
# Register redirect URI:  <site-url>/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
# [optional] Server-only half of the pair above. Never expose to the browser.
GOOGLE_OAUTH_CLIENT_SECRET=

# [optional] AES-256-GCM key encrypting stored OAuth tokens at rest, 32-byte
# hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_TOKEN_KEY=


# --- Feature gates (unset or "false" = off) --------------------------------
# These are deliberately opt-in. Each guards a path that is not finished or not
# yet owner-approved, so the safe default is off.

# [optional] Enables the canonical Connects ledger schema path.
CONNECTS_CANONICAL_ACTIVE=

# [optional] Enables the FAQ appeal workflow.
FAQ_APPEAL_ACTIVE=

# [optional] Enables lead-export audit logging.
LEAD_EXPORT_AUDIT_ACTIVE=

# [optional] Opens premium features during the pre-200-listing period.
SCOUTIT_PRE_200_PREMIUM_LOCKER=


# --- Operational ids -------------------------------------------------------

# [optional] Supabase user id credited as the actor when the stale-listing cron
# files an admin action. Absent: the cron records no actor.
STALE_LISTING_ADMIN_USER_ID=

# [optional] Comma-separated Supabase auth user UUIDs permitted to receive
# inquiries for records explicitly marked as sample data. Unset = fail closed.
HUMAN_TEST_SAMPLE_RECIPIENT_IDS=


# --- Test harness ----------------------------------------------------------
# Set only by the E2E suite. Never set these in a real environment: they relax
# behaviour for deterministic tests.

# [optional] Server-side E2E mode.
SCOUTIT_E2E=

# [optional] Client-side E2E mode.
NEXT_PUBLIC_SCOUTIT_E2E=
